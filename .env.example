# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
EMBEDDING_MODEL="gemini-embedding-001"
GENERATION_MODEL="gemini-3.5-flash-lite"

# Weaviate Configuration
WEAVIATE_MODE="cloud"
WEAVIATE_URL="https://your-cluster-id.c0.region.weaviate.cloud"
WEAVIATE_API_KEY="your-weaviate-api-key"
COLLECTION_NAME="MultiTenantRAG"

# PDF Ingestion Settings
PDF_PATH="app/data/Attention is all you need.pdf"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4

# Firebase Authentication (Verification on Backend)
FIREBASE_PROJECT_ID="your-firebase-project-id"
