# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
EMBEDDING_MODEL="gemini-embedding-001"
GENERATION_MODEL="gemini-3.5-flash-lite"

# Weaviate Configuration
WEAVIATE_MODE="cloud"
WEAVIATE_URL="https://your-cluster-id.c0.region.weaviate.cloud"
WEAVIATE_API_KEY="your-weaviate-api-key"
COLLECTION_NAME="MultiTenantRAG"

# PDF Ingestion & Retrieval Pipeline Settings
PDF_PATH="app/data/Attention is all you need.pdf"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
RETRIEVAL_TOP_K=20
RERANK_TOP_K=4
DISTANCE_THRESHOLD=0.30

# Cohere Reranking Configuration
COHERE_API_KEY="your-cohere-api-key"
RERANK_MODEL="rerank-english-v3.0"

# Firebase Authentication (Verification on Backend)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_PATH="path/to/serviceAccountKey.json"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

